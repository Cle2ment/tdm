{
  "name": "@typedecision/runtime",
  "version": "0.1.0",
  "description": "Native (napi-rs) binding for the TDM decision runtime: judge/health in-process.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "github.com/Cle2ment/tdm",
    "directory": "backend/tdm-napi"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "index.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "tdm-runtime"
  },
  "scripts": {
    "build": "napi build --platform --no-js --release",
    "build:debug": "napi build --platform --no-js",
    "smoke": "node scripts/smoke.ts",
    "smoke:bun": "bun scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typedecision/contract": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@types/node": "^26",
    "typescript": "^7"
  }
}
