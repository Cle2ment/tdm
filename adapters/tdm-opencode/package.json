{
  "name": "@typedecision/opencode-tdm",
  "version": "0.1.2",
  "description": "TDM harness adapter for opencode: registers a tdm_judge tool for typed, auditable judgments and an automatic execute.before risk gate that escalates risky tool calls to user confirmation.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tdm",
    "typed-decision-model",
    "ai-agent",
    "jev"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cle2ment/tdm.git",
    "directory": "adapters/tdm-opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typedecision/runtime": "workspace:*",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "@typedecision/client": "workspace:*",
    "@typedecision/contract": "workspace:*",
    "@types/node": "^26",
    "tsdown": "latest",
    "typescript": "^6",
    "vitest": "latest"
  }
}
