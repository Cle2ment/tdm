{
  "name": "@typedecision/opencode",
  "version": "0.1.0",
  "description": "TDM harness adapter for opencode: registers a tdm_judge tool for typed, auditable judgments and an automatic execute.before risk gate that escalates risky tool calls to user confirmation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "github.com/Cle2ment/tdm",
    "directory": "adapters/tdm-opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@typedecision/client": "workspace:*",
    "@typedecision/contract": "workspace:*",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "typescript": "latest",
    "vitest": "latest"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
